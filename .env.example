# Public browser configuration only. These values are safe to expose when
# Supabase Row Level Security and Edge Function authorization are configured.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. Defaults to / for a custom domain or root site.
VITE_BASE_PATH=/

# Optional. Leave blank until a real Meta Pixel is configured.
VITE_META_PIXEL_ID=
